# Environment variables required for development / production

# Server port (optional)
PORT=3000

# MySQL configuration (optional; if not provided, server will use leads_db.json fallback)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=r4realty_db

# Strong admin PIN (required) — must be set before starting the server
ADMIN_PIN=your-strong-admin-pin-here
